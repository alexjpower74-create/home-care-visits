{
  "name": "home-care-visits-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sample": "node tools/build-sample-data.mjs",
    "migrate": "wrangler d1 migrations apply home-care-visits --local --persist-to .state-dev",
    "dev": "npm run migrate && wrangler dev --local --port 7902 --inspector-port 7912 --persist-to .state-dev",
    "test": "node tests/run.mjs",
    "negative:idempotent": "node tests/negative-idempotent.mjs",
    "negative:time": "node tests/negative-time.mjs",
    "negative:familynote": "node tests/negative-familynote.mjs",
    "negative:alert": "node tests/negative-alert.mjs",
    "negative:travelgap": "node tests/negative-travelgap.mjs",
    "negative": "node tests/negative-idempotent.mjs && node tests/negative-time.mjs && node tests/negative-familynote.mjs && node tests/negative-alert.mjs && node tests/negative-travelgap.mjs"
  }
}
